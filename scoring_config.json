{
  "version": "1.0",
  "description": "谈吐素养训练 · 反馈与评分配置",
  "dimensions": [
    {
      "id": "material",
      "name": "素材调用",
      "name_en": "Material",
      "definition": "经典素材使用的准确性与自然度",
      "weight_default": 0.20,
      "auto_scorable": "high",
      "human_priority": "medium"
    },
    {
      "id": "structure",
      "name": "结构完整",
      "name_en": "Structure",
      "definition": "表达是否有清晰组织（开头-展开-收束）",
      "weight_default": 0.20,
      "auto_scorable": "medium_high",
      "human_priority": "medium"
    },
    {
      "id": "context",
      "name": "语境适配",
      "name_en": "Context",
      "definition": "是否符合场景、身份、关系与沟通目标",
      "weight_default": 0.20,
      "auto_scorable": "medium",
      "human_priority": "high"
    },
    {
      "id": "rhetoric",
      "name": "修辞表现",
      "name_en": "Rhetoric",
      "definition": "语言的节奏、力量与美感",
      "weight_default": 0.15,
      "auto_scorable": "medium",
      "human_priority": "high"
    },
    {
      "id": "thinking",
      "name": "思维深度",
      "name_en": "Thinking",
      "definition": "是否有独立思考、层次与辩证性",
      "weight_default": 0.15,
      "auto_scorable": "low",
      "human_priority": "high"
    },
    {
      "id": "fluency",
      "name": "表达流畅",
      "name_en": "Fluency",
      "definition": "口头/书面的顺畅程度与时间控制",
      "weight_default": 0.10,
      "auto_scorable": "high",
      "human_priority": "medium"
    }
  ],
  "type_weights": {
    "金句嵌入": {
      "material": 0.30,
      "structure": 0.15,
      "context": 0.25,
      "rhetoric": 0.15,
      "thinking": 0.05,
      "fluency": 0.10
    },
    "仿写改写": {
      "material": 0.20,
      "structure": 0.10,
      "context": 0.20,
      "rhetoric": 0.30,
      "thinking": 0.10,
      "fluency": 0.10
    },
    "即兴发言": {
      "material": 0.25,
      "structure": 0.20,
      "context": 0.15,
      "rhetoric": 0.10,
      "thinking": 0.15,
      "fluency": 0.15
    },
    "辩论反驳": {
      "material": 0.15,
      "structure": 0.25,
      "context": 0.15,
      "rhetoric": 0.10,
      "thinking": 0.25,
      "fluency": 0.10
    },
    "情境角色扮演": {
      "material": 0.10,
      "structure": 0.15,
      "context": 0.35,
      "rhetoric": 0.10,
      "thinking": 0.15,
      "fluency": 0.15
    },
    "结构模板填充": {
      "material": 0.20,
      "structure": 0.35,
      "context": 0.15,
      "rhetoric": 0.10,
      "thinking": 0.10,
      "fluency": 0.10
    },
    "快速反应": {
      "material": 0.25,
      "structure": 0.10,
      "context": 0.20,
      "rhetoric": 0.15,
      "thinking": 0.05,
      "fluency": 0.25
    }
  },
  "auto_signals": [
    {
      "id": "material_hit",
      "name": "素材命中",
      "method": "exact_match + semantic_similarity",
      "dimension": "material",
      "description": "检测是否使用了指定或相关经典素材"
    },
    {
      "id": "material_count",
      "name": "素材数量达标",
      "method": "count_hits_vs_requirement",
      "dimension": "material"
    },
    {
      "id": "structure_markers",
      "name": "结构标记",
      "method": "rule_based + light_classifier",
      "dimension": "structure",
      "description": "检测观点句、转折、总结等结构信号"
    },
    {
      "id": "time_control",
      "name": "时间控制",
      "method": "duration_vs_limit",
      "dimension": "fluency",
      "tolerance": 0.20
    },
    {
      "id": "redundancy",
      "name": "冗余度",
      "method": "repetition_ratio + filler_density",
      "dimension": "fluency"
    },
    {
      "id": "toxicity",
      "name": "攻击性/不得体",
      "method": "sensitive_word + toxicity_model",
      "dimension": "context"
    }
  ],
  "score_levels": [
    {"min": 90, "max": 100, "label": "优秀", "color": "green"},
    {"min": 75, "max": 89, "label": "良好", "color": "blue"},
    {"min": 60, "max": 74, "label": "合格", "color": "yellow"},
    {"min": 0, "max": 59, "label": "待提升", "color": "red"}
  ],
  "feedback_principles": [
    "先肯定后建议",
    "具体到句子或段落",
    "每条改进对应可执行动作",
    "自动反馈控制在3-5个要点",
    "使用雷达图可视化六维得分"
  ],
  "human_review_template": {
    "sections": [
      {"id": "overall", "title": "综合印象", "required": true},
      {"id": "highlights", "title": "亮点", "required": true},
      {"id": "improvements", "title": "可提升之处", "required": true},
      {"id": "style", "title": "风格观察", "required": false},
      {"id": "next", "title": "下一步建议", "required": true}
    ]
  },
  "mvp_scope": [
    "文本提交",
    "自动素材命中检测",
    "素材调用、结构完整、表达流畅三个维度自动打分",
    "简单反馈卡片（亮点+改进+推荐下一题）",
    "人工点评入口（表单收集）"
  ]
}
